<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Rambl.Components"
             x:Class="Rambl.Components.SearchField"
             HeightRequest="36">
    <Border x:Name="Outline" StrokeShape="RoundRectangle 6" StrokeThickness="1" Padding="12,0"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource ContentBgLight}, Dark={StaticResource ContentBgDark}}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Label Style="{StaticResource Icon}" Text="{x:Static components:Icons.Search}"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
            <Entry x:Name="Input" Grid.Column="1" FontFamily="Inter" FontSize="13" MinimumHeightRequest="0"
                   VerticalOptions="Center" BackgroundColor="Transparent" ReturnType="Search"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   TextChanged="OnTextChanged" Focused="OnFocusChanged" Unfocused="OnFocusChanged" />
            <!-- Kept visible but disabled while the query is empty, as in the design. -->
            <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                    WidthRequest="24" HeightRequest="24" MinimumWidthRequest="24" MinimumHeightRequest="24"
                    Padding="0" CornerRadius="12" IsEnabled="False" VerticalOptions="Center"
                    SemanticProperties.Description="Clear search" Clicked="OnClearClicked">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Lucide" Glyph="&#xe1b2;" Size="14"
                                     Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Button.ImageSource>
            </Button>
        </Grid>
    </Border>
</ContentView>
