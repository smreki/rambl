<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rambl.Components.ShortcutInput"
             WidthRequest="272">
    <Grid ColumnDefinitions="*,80" ColumnSpacing="8">
        <Button x:Name="ChangeButton" Style="{StaticResource ShortcutButton}"
                Clicked="OnChangeClicked" />
        <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource InputResetButton}"
                Clicked="OnResetClicked" />
    </Grid>
</ContentView>
