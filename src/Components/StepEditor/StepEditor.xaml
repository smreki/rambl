<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Rambl.Components"
             x:Class="Rambl.Components.StepEditor">
    <!-- One pre-processing step of a read-aloud profile: the same fields as a post-processing process, in a card. -->
    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Padding="16"
            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource ContentBgLight}, Dark={StaticResource ContentBgDark}}">
        <VerticalStackLayout Spacing="16">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Border WidthRequest="20" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ProcessingSoftLight}, Dark={StaticResource ProcessingSoftDark}}">
                    <Label x:Name="NumberLabel" FontFamily="InterSemiBold" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ProcessingLight}, Dark={StaticResource ProcessingDark}}" />
                </Border>
                <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <components:IconButton x:Name="MoveUpButton" Grid.Column="2" Glyph="{x:Static components:Icons.ArrowUp}" GlyphSize="14"
                                       WidthRequest="28" HeightRequest="28" AccessibleName="Move step up" Clicked="OnMoveUpClicked" />
                <components:IconButton x:Name="MoveDownButton" Grid.Column="3" Glyph="{x:Static components:Icons.ArrowDown}" GlyphSize="14"
                                       WidthRequest="28" HeightRequest="28" AccessibleName="Move step down" Clicked="OnMoveDownClicked" />
                <components:IconButton x:Name="RemoveButton" Grid.Column="4" Glyph="{x:Static components:Icons.Trash2}" GlyphSize="14"
                                       WidthRequest="28" HeightRequest="28" IsDestructive="True" AccessibleName="Remove step"
                                       Clicked="OnRemoveClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="Provider" FontFamily="InterMedium" FontSize="13" />
                    <Label Style="{StaticResource SettingHelp}" Text="Runs on this PC. No text leaves it." />
                </VerticalStackLayout>
                <components:SelectInput x:Name="ProviderSelect" Grid.Column="1" WidthRequest="360"
                                        Glyph="{x:Static components:Icons.Cpu}" AccessibleName="Provider" />
            </Grid>

            <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="Model" FontFamily="InterMedium" FontSize="13" />
                    <Label x:Name="ModelHelpLabel" Style="{StaticResource SettingHelp}" Text="Downloaded language models that can generate text." />
                </VerticalStackLayout>
                <!-- A select with a two-line value. The button lies on top so the whole field is one control. -->
                <Grid x:Name="ModelSelect" Grid.Column="1" WidthRequest="360" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 6" StrokeThickness="1" Padding="12,8"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ContentBgLight}, Dark={StaticResource ContentBgDark}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ModelNameLabel" FontFamily="InterMedium" FontSize="13" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label x:Name="ModelDetailLabel" Style="{StaticResource SettingHelp}" LineBreakMode="TailTruncation"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource Icon}" FontSize="16" VerticalOptions="Center"
                                   Text="{x:Static components:Icons.ChevronDown}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </Grid>
                    </Border>
                    <Button x:Name="ModelSelectButton" Style="{StaticResource GhostButton}" HeightRequest="-1" MinimumHeightRequest="0"
                            CornerRadius="6" Padding="0" SemanticProperties.Description="Model" Clicked="OnModelSelectClicked" />
                </Grid>
            </Grid>

            <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="Time limit" FontFamily="InterMedium" FontSize="13" />
                    <Label Style="{StaticResource SettingHelp}"
                           Text="If the model takes longer, the selected text is read as it is." />
                </VerticalStackLayout>
                <components:SelectInput x:Name="TimeoutSelect" Grid.Column="1" WidthRequest="360"
                                        Glyph="{x:Static components:Icons.Timer}" AccessibleName="Time limit"
                                        SelectedIndexChanged="OnTimeoutChanged" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="Instruction" FontFamily="InterMedium" FontSize="13" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <components:IconButton HeightRequest="28" Glyph="{x:Static components:Icons.Braces}" GlyphSize="12"
                                               Text="Insert {{original}}" IsOutlined="True"
                                               AccessibleName="Insert the selected text variable" Clicked="OnInsertOriginalClicked" />
                        <components:IconButton HeightRequest="28" Glyph="{x:Static components:Icons.Braces}" GlyphSize="12"
                                               Text="Insert {{processed}}" IsOutlined="True"
                                               AccessibleName="Insert the previous step's result variable" Clicked="OnInsertProcessedClicked" />
                    </HorizontalStackLayout>
                </Grid>
                <components:TextArea x:Name="InstructionEditor" MinimumTextHeight="120"
                                     Placeholder="Tell the model what to do with the text, for example: Translate the text below into German. Answer with the translation only. {{original}}"
                                     AccessibleName="Instruction" PropertyChanged="OnInstructionPropertyChanged" />
                <Label Style="{StaticResource SettingHelp}" LineBreakMode="WordWrap"
                       Text="{}{{original}} is the selected text; {{processed}} is the result of the step before (the selected text in the first step). With neither, the text follows your instruction." />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
