<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>Rambl</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiVersion>10.0.120</MauiVersion>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Rambl</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>jam.rambl</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.5.0</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

	</PropertyGroup>

	<!-- sherpa-onnx (Features/Stt/Sherpa, Features/Tts/Sherpa) is not tied to Windows, but its NuGet package has no Mac Catalyst native library
	     yet. Set this to true for a target once the library has been checked to load there. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseSherpaOnnx>true</UseSherpaOnnx>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseSherpaOnnx)' == 'true'">
		<DefineConstants>$(DefineConstants);SHERPA_ONNX</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseSherpaOnnx)' == 'true'">
		<!-- 2.x removes the built-in eSpeak frontend: Piper and Kokoro's out-of-lexicon words need it.
		     Keep 1.x until an external phonemizer is integrated for both voice families. -->
		<PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseSherpaOnnx)' != 'true'">
		<Compile Remove="Features\Stt\Sherpa\**" />
		<Compile Remove="Features\Tts\Sherpa\**" />
		<Compile Remove="Features\Inference\SherpaOnnx\**" />
	</ItemGroup>

	<!-- ONNX Runtime (Features/Decisions/Laya) runs the Laya decision models for voice commands. The native onnxruntime.dll
	     is the one sherpa-onnx ships, so only the managed API is referenced, and only where sherpa-onnx is. The Windows App
	     SDK brings a Windows ML build of the same assembly; this package's newer version wins. -->
	<PropertyGroup Condition="'$(UseSherpaOnnx)' == 'true'">
		<UseOnnxRuntime>true</UseOnnxRuntime>
		<DefineConstants>$(DefineConstants);ONNX_RUNTIME</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseOnnxRuntime)' == 'true'">
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseOnnxRuntime)' != 'true'">
		<Compile Remove="Features\Decisions\Laya\LayaModel.cs;Features\Decisions\Laya\LayaRuntime.cs" />
	</ItemGroup>

	<!-- Silero VAD (Features/Stt/Sherpa/SileroSpeechDetector), which finds the speech in a recording before a model that
	     transcribes whole recordings runs, is one small ONNX file from sherpa-onnx's model release. The build fetches it,
	     checks it against the pinned SHA-256 (the release tag is not versioned, so the hash is what pins it) and copies it
	     into a vad folder next to the app. -->
	<PropertyGroup Condition="'$(UseSherpaOnnx)' == 'true'">
		<SileroVadSha256>9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6</SileroVadSha256>
		<SileroVadCacheDir>$(MSBuildProjectDirectory)\..\.native\silero-vad\$(SileroVadSha256.Substring(0, 12))\</SileroVadCacheDir>
	</PropertyGroup>

	<Target Name="FetchSileroVad" BeforeTargets="AssignTargetPaths" Condition="'$(UseSherpaOnnx)' == 'true'">
		<PropertyGroup>
			<SileroVadFile>$(SileroVadCacheDir)silero_vad.onnx</SileroVadFile>
			<SileroVadChecked>$(SileroVadCacheDir)checked</SileroVadChecked>
		</PropertyGroup>

		<DownloadFile Condition="!Exists('$(SileroVadChecked)')"
		              SourceUrl="https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx"
		              DestinationFolder="$(SileroVadCacheDir)" SkipUnchangedFiles="true" />
		<GetFileHash Condition="!Exists('$(SileroVadChecked)')" Files="$(SileroVadFile)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="SileroVadHash" />
		</GetFileHash>
		<Error Condition="!Exists('$(SileroVadChecked)') And '%(SileroVadHash.FileHash)' != '$(SileroVadSha256)'"
		       Text="The downloaded Silero VAD model does not match the pinned SHA-256. Delete $(SileroVadCacheDir) and build again, or update SileroVadSha256 after checking the file." />
		<Touch Condition="!Exists('$(SileroVadChecked)')" Files="$(SileroVadChecked)" AlwaysCreate="true" />

		<ItemGroup>
			<None Include="$(SileroVadFile)" Link="vad\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- parakeet.cpp (Features/Stt/ParakeetCpp) is one prebuilt native library, parakeet.dll, which is fetched from its
	     GitHub release at build time and checked against a pinned hash. Only the Windows x64 CPU build is wired up;
	     set this for another target once its library has been checked to load there. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseParakeetCpp>true</UseParakeetCpp>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseParakeetCpp)' == 'true'">
		<DefineConstants>$(DefineConstants);PARAKEET_CPP</DefineConstants>
		<ParakeetCppVersion>0.6.1</ParakeetCppVersion>
		<ParakeetCppZipName>parakeet-v$(ParakeetCppVersion)-lib-win-cpu-x64</ParakeetCppZipName>
		<ParakeetCppZipSha256>95b41515efeab246094d1793a1c0a12d727bc1cc01e4c28fe37a16a994b26774</ParakeetCppZipSha256>
		<ParakeetCppCacheDir>$(MSBuildProjectDirectory)\..\.native\parakeet.cpp\$(ParakeetCppVersion)\</ParakeetCppCacheDir>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseParakeetCpp)' != 'true'">
		<Compile Remove="Features\Stt\ParakeetCpp\**" />
	</ItemGroup>

	<Target Name="FetchParakeetCpp" BeforeTargets="AssignTargetPaths" Condition="'$(UseParakeetCpp)' == 'true'">
		<PropertyGroup>
			<ParakeetCppZip>$(ParakeetCppCacheDir)$(ParakeetCppZipName).zip</ParakeetCppZip>
			<ParakeetCppDll>$(ParakeetCppCacheDir)$(ParakeetCppZipName)\parakeet.dll</ParakeetCppDll>
		</PropertyGroup>

		<DownloadFile Condition="!Exists('$(ParakeetCppDll)')"
		              SourceUrl="https://github.com/mudler/parakeet.cpp/releases/download/v$(ParakeetCppVersion)/$(ParakeetCppZipName).zip"
		              DestinationFolder="$(ParakeetCppCacheDir)" SkipUnchangedFiles="true" />
		<GetFileHash Condition="!Exists('$(ParakeetCppDll)')" Files="$(ParakeetCppZip)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="ParakeetCppZipHash" />
		</GetFileHash>
		<Error Condition="!Exists('$(ParakeetCppDll)') And '%(ParakeetCppZipHash.FileHash)' != '$(ParakeetCppZipSha256)'"
		       Text="The downloaded parakeet.cpp release does not match the pinned SHA-256. Delete $(ParakeetCppCacheDir) and build again, or update ParakeetCppZipSha256 after checking the release." />
		<Unzip Condition="!Exists('$(ParakeetCppDll)')" SourceFiles="$(ParakeetCppZip)" DestinationFolder="$(ParakeetCppCacheDir)" />

		<ItemGroup>
			<None Include="$(ParakeetCppDll)" Link="parakeet.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- transcribe.cpp (Features/Stt/TranscribeCpp) runs GGUF speech models of many families through its C API. Its release is
	     a tarball of transcribe.dll with ggml as separate libraries (ggml.dll, ggml-base.dll and one ggml-cpu-*.dll per CPU
	     generation, which the library picks at run time), so they go into a transcribe.cpp folder next to the app, where
	     no other ggml can be found by mistake. The Vulkan backend is left out: Rambl runs speech on the CPU only for now.
	     The tarball is unpacked with Windows' own tar.exe, named by its full path because Git's GNU tar, if it comes first
	     on PATH, reads "C:" as a remote host. Only the Windows x64 CPU build is wired up. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseTranscribeCpp>true</UseTranscribeCpp>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseTranscribeCpp)' == 'true'">
		<DefineConstants>$(DefineConstants);TRANSCRIBE_CPP</DefineConstants>
		<TranscribeCppVersion>0.4.1</TranscribeCppVersion>
		<TranscribeCppArchiveName>transcribe-native-$(TranscribeCppVersion)-windows-x86_64-cpu-vulkan</TranscribeCppArchiveName>
		<TranscribeCppArchiveSha256>272eb97795048ccb557c85bb9dd44c9e530e1c928443114c39816a8a5f76269d</TranscribeCppArchiveSha256>
		<TranscribeCppCacheDir>$(MSBuildProjectDirectory)\..\.native\transcribe.cpp\$(TranscribeCppVersion)\</TranscribeCppCacheDir>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseTranscribeCpp)' != 'true'">
		<Compile Remove="Features\Stt\TranscribeCpp\**" />
	</ItemGroup>

	<Target Name="FetchTranscribeCpp" BeforeTargets="AssignTargetPaths" Condition="'$(UseTranscribeCpp)' == 'true'">
		<PropertyGroup>
			<TranscribeCppArchive>$(TranscribeCppCacheDir)$(TranscribeCppArchiveName).tar.gz</TranscribeCppArchive>
			<TranscribeCppBinDir>$(TranscribeCppCacheDir)transcribe-native-windows-x86_64-cpu-vulkan\</TranscribeCppBinDir>
			<TranscribeCppDll>$(TranscribeCppBinDir)transcribe.dll</TranscribeCppDll>
		</PropertyGroup>

		<DownloadFile Condition="!Exists('$(TranscribeCppDll)')"
		              SourceUrl="https://github.com/handy-computer/transcribe.cpp/releases/download/v$(TranscribeCppVersion)/$(TranscribeCppArchiveName).tar.gz"
		              DestinationFolder="$(TranscribeCppCacheDir)" SkipUnchangedFiles="true" />
		<GetFileHash Condition="!Exists('$(TranscribeCppDll)')" Files="$(TranscribeCppArchive)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="TranscribeCppArchiveHash" />
		</GetFileHash>
		<Error Condition="!Exists('$(TranscribeCppDll)') And '%(TranscribeCppArchiveHash.FileHash)' != '$(TranscribeCppArchiveSha256)'"
		       Text="The downloaded transcribe.cpp release does not match the pinned SHA-256. Delete $(TranscribeCppCacheDir) and build again, or update TranscribeCppArchiveSha256 after checking the release." />
		<Exec Condition="!Exists('$(TranscribeCppDll)')"
		      Command="&quot;$(SystemRoot)\System32\tar.exe&quot; -xzf &quot;$(TranscribeCppArchive)&quot; -C &quot;$(TranscribeCppCacheDir.TrimEnd('\'))&quot;" />

		<ItemGroup>
			<TranscribeCppFile Include="$(TranscribeCppBinDir)transcribe.dll;$(TranscribeCppBinDir)ggml.dll;$(TranscribeCppBinDir)ggml-base.dll;$(TranscribeCppBinDir)ggml-cpu-*.dll" />
			<None Include="@(TranscribeCppFile)" Link="transcribe.cpp\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<TranscribeCppLicense Include="$(TranscribeCppBinDir)licenses\**\*" />
			<None Include="@(TranscribeCppLicense)" Link="transcribe.cpp\licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- llama.cpp runs inside Rambl through a small C bridge. Build its pinned source with static ggml so STT's
	     other ggml versions can coexist. No server, executable, or upstream ggml DLL is shipped for language inference. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseLlamaCpp>true</UseLlamaCpp>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseLlamaCpp)' == 'true'">
		<DefineConstants>$(DefineConstants);LLAMA_CPP</DefineConstants>
		<LlamaCppVersion>b12182</LlamaCppVersion>
		<LlamaCppSourceSha256>adc18ac17ece6139a009399181dc31accb5ab5337115180df7b7006e56deaeef</LlamaCppSourceSha256>
		<LlamaCppCacheDir>$(MSBuildProjectDirectory)\..\.native\rambl-llama\$(LlamaCppVersion)\</LlamaCppCacheDir>
		<LlamaCppDll>$(LlamaCppCacheDir)build\Release\rambl-llama.dll</LlamaCppDll>
		<LlamaCppAvx2Dll>$(LlamaCppCacheDir)build-avx2\Release\rambl-llama-avx2.dll</LlamaCppAvx2Dll>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseLlamaCpp)' != 'true'">
		<Compile Remove="Features\LanguageModels\LlamaCpp\**" />
		<Compile Remove="Features\Inference\LlamaCpp\**;Features\Stt\LlamaCpp\**;Features\Tts\LlamaCpp\**" />
	</ItemGroup>

	<Target Name="BuildLlamaCpp" Condition="'$(UseLlamaCpp)' == 'true'"
	        Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)\..\tools\Build-LlamaNative.ps1;$(MSBuildProjectDirectory)\..\tools\native\llama\CMakeLists.txt;$(MSBuildProjectDirectory)\..\tools\native\llama\rambl-llama.cpp"
	        Outputs="$(LlamaCppDll);$(LlamaCppAvx2Dll)">
		<Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Build-LlamaNative.ps1&quot; -Version &quot;$(LlamaCppVersion)&quot; -SourceSha256 &quot;$(LlamaCppSourceSha256)&quot; -CacheDirectory &quot;$(LlamaCppCacheDir.TrimEnd('\'))&quot;" />
	</Target>

	<Target Name="FetchLlamaCpp" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildLlamaCpp" Condition="'$(UseLlamaCpp)' == 'true'">
		<ItemGroup>
			<None Include="$(LlamaCppDll)" Link="llama.cpp\rambl-llama.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="$(LlamaCppAvx2Dll)" Link="llama.cpp\rambl-llama-avx2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="$(LlamaCppCacheDir)llama.cpp-$(LlamaCppVersion)\LICENSE" Link="llama.cpp\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<LlamaCppLicense Include="$(LlamaCppCacheDir)llama.cpp-$(LlamaCppVersion)\licenses\*" />
			<None Include="@(LlamaCppLicense)" Link="llama.cpp\licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<LlamaCppVendorLicense Include="$(LlamaCppCacheDir)llama.cpp-$(LlamaCppVersion)\vendor\**\LICENSE*" />
			<None Include="@(LlamaCppVendorLicense)" Link="llama.cpp\licenses\vendor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- audio.cpp is a separate process, so its ggml never conflicts with the STT or language runtimes.
	     The Windows Vulkan build also has a CPU backend; Rambl falls back to it if Vulkan cannot load the model. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseAudioCpp>true</UseAudioCpp>
	</PropertyGroup>

	<PropertyGroup Condition="'$(UseAudioCpp)' == 'true'">
		<DefineConstants>$(DefineConstants);AUDIO_CPP</DefineConstants>
		<AudioCppVersion>0.9.4</AudioCppVersion>
		<AudioCppZipName>audio-v$(AudioCppVersion)-bin-windows-x64-vulkan</AudioCppZipName>
		<AudioCppZipSha256>804f70cf47c7b8450ef37e76fc04ecee71728345061f6e749a412932dd7db7a7</AudioCppZipSha256>
		<AudioCppCacheDir>$(MSBuildProjectDirectory)\..\.native\audio.cpp\$(AudioCppVersion)\</AudioCppCacheDir>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseAudioCpp)' != 'true'">
		<Compile Remove="Features\Tts\AudioCpp\**" />
	</ItemGroup>

	<Target Name="FetchAudioCpp" BeforeTargets="AssignTargetPaths" Condition="'$(UseAudioCpp)' == 'true'">
		<PropertyGroup>
			<AudioCppZip>$(AudioCppCacheDir)$(AudioCppZipName).zip</AudioCppZip>
			<AudioCppBinDir>$(AudioCppCacheDir)bin\</AudioCppBinDir>
			<AudioCppChecked>$(AudioCppBinDir)$(AudioCppZipSha256).checked</AudioCppChecked>
		</PropertyGroup>
		<DownloadFile Condition="!Exists('$(AudioCppChecked)')"
		              SourceUrl="https://github.com/0xShug0/audio.cpp/releases/download/v$(AudioCppVersion)/$(AudioCppZipName).zip"
		              DestinationFolder="$(AudioCppCacheDir)" SkipUnchangedFiles="true" />
		<GetFileHash Condition="!Exists('$(AudioCppChecked)')" Files="$(AudioCppZip)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="AudioCppZipHash" />
		</GetFileHash>
		<Error Condition="!Exists('$(AudioCppChecked)') And '%(AudioCppZipHash.FileHash)' != '$(AudioCppZipSha256)'"
		       Text="The downloaded audio.cpp release does not match the pinned SHA-256. Delete $(AudioCppCacheDir) and build again, or update the pin after checking the release." />
		<Unzip Condition="!Exists('$(AudioCppChecked)')" SourceFiles="$(AudioCppZip)" DestinationFolder="$(AudioCppBinDir)" />
		<Touch Condition="!Exists('$(AudioCppChecked)')" Files="$(AudioCppChecked)" AlwaysCreate="true" />
		<ItemGroup>
			<AudioCppFile Include="$(AudioCppBinDir)audiocpp_server.exe;$(AudioCppBinDir)*.dll;$(AudioCppBinDir)LICENSE*" />
			<None Include="@(AudioCppFile)" Link="audio.cpp\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<!-- Model specs supply family-specific options to the server. -->
			<None Include="$(AudioCppBinDir)model_specs\qwen3_tts.json" Link="audio.cpp\model_specs\qwen3_tts.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="$(AudioCppBinDir)model_specs\kokoro_tts.json" Link="audio.cpp\model_specs\kokoro_tts.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<!-- Only the native DLL and dictionaries are extracted from this wheel; Python is not installed or run.
	     Kokoro's server loads them explicitly, so neither its DLL nor its process-global state enters Rambl. -->
	<PropertyGroup Condition="'$(UseAudioCpp)' == 'true'">
		<EspeakLoaderVersion>0.2.4</EspeakLoaderVersion>
		<EspeakLoaderSha256>41f1e08ac9deda2efd1ea9de0b81dab9f5ae3c4b24284f76533d0a7b1dd7abd7</EspeakLoaderSha256>
		<EspeakLoaderUrl>https://files.pythonhosted.org/packages/9d/ed/a3d872fbad4f3a3f3db0e8c31768ab14e77cd77306de16b8b20b1e1df7ea/espeakng_loader-$(EspeakLoaderVersion)-py3-none-win_amd64.whl</EspeakLoaderUrl>
		<EspeakLoaderCacheDir>$(MSBuildProjectDirectory)\..\.native\espeakng-loader\$(EspeakLoaderVersion)\</EspeakLoaderCacheDir>
	</PropertyGroup>

	<Target Name="FetchKokoroPhonemizer" BeforeTargets="AssignTargetPaths" Condition="'$(UseAudioCpp)' == 'true'">
		<PropertyGroup>
			<EspeakLoaderArchive>$(EspeakLoaderCacheDir)espeakng_loader-$(EspeakLoaderVersion)-py3-none-win_amd64.whl</EspeakLoaderArchive>
			<EspeakLoaderChecked>$(EspeakLoaderCacheDir)$(EspeakLoaderSha256).checked</EspeakLoaderChecked>
			<EspeakLoaderFiles>$(EspeakLoaderCacheDir)espeakng_loader\</EspeakLoaderFiles>
		</PropertyGroup>
		<DownloadFile Condition="!Exists('$(EspeakLoaderChecked)')" SourceUrl="$(EspeakLoaderUrl)" DestinationFolder="$(EspeakLoaderCacheDir)" SkipUnchangedFiles="true" />
		<GetFileHash Condition="!Exists('$(EspeakLoaderChecked)')" Files="$(EspeakLoaderArchive)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="EspeakLoaderHash" />
		</GetFileHash>
		<Error Condition="!Exists('$(EspeakLoaderChecked)') And '%(EspeakLoaderHash.FileHash)' != '$(EspeakLoaderSha256)'" Text="The downloaded Kokoro phonemizer does not match the pinned SHA-256." />
		<Unzip Condition="!Exists('$(EspeakLoaderChecked)')" SourceFiles="$(EspeakLoaderArchive)" DestinationFolder="$(EspeakLoaderCacheDir)" />
		<Touch Condition="!Exists('$(EspeakLoaderChecked)')" Files="$(EspeakLoaderChecked)" AlwaysCreate="true" />
		<ItemGroup>
			<None Include="$(EspeakLoaderFiles)espeak-ng.dll" Link="audio.cpp\espeak\espeak-ng.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<KokoroEspeakData Include="$(EspeakLoaderFiles)espeak-ng-data\**\*" />
			<None Include="@(KokoroEspeakData)" Link="audio.cpp\espeak\espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="..\tools\licenses\espeak-ng-COPYING.txt" Link="audio.cpp\espeak\licenses\COPYING.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="..\tools\licenses\espeak-ng-NOTICE.txt" Link="audio.cpp\espeak\licenses\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Optional single-file experiment. WinUI requires extracting the bundled Microsoft runtime at launch;
	     keep Rambl's path-based native runtimes and data next to the executable. Not used by the release workflow. -->
	<!-- A package downgrade can have older source timestamps than files from a previous publish. Always copy
	     these native dependencies so incremental publishes cannot mix managed and native runtime versions. -->
	<Target Name="ReplacePublishedSherpaRuntime" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
			                       Condition="'%(ResolvedFileToPublish.RelativePath)' == 'onnxruntime.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'onnxruntime_providers_shared.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'sherpa-onnx-c-api.dll'">
				<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<Target Name="KeepRamblNativeFilesOutsideBundle" BeforeTargets="_ComputeFilesToBundle"
	        Condition="'$(RamblHybridPublish)' == 'true' And '$(PublishSingleFile)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
			                       Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^(audio\.cpp|llama\.cpp|transcribe\.cpp|vad)[/\\]'))">
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
			                       Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appicon.ico' Or '%(ResolvedFileToPublish.RelativePath)' == 'parakeet.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'onnxruntime.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'onnxruntime_providers_shared.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'sherpa-onnx.dll' Or '%(ResolvedFileToPublish.RelativePath)' == 'sherpa-onnx-c-api.dll'">
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="256,256" Resize="true" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="..\README.md" LogicalName="README.md" />
		<MauiAsset Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
	</ItemGroup>

