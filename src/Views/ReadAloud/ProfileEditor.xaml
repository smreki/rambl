<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Rambl.Components"
             x:Class="Rambl.Views.ProfileEditor"
             SizeChanged="OnSizeChanged">
    <ContentView.Resources>
        <Style x:Key="RadioSlider" TargetType="Slider" BasedOn="{StaticResource SettingSlider}">
            <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource SpeakingLight}, Dark={StaticResource SpeakingDark}}" />
            <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource SpeakingLight}, Dark={StaticResource SpeakingDark}}" />
        </Style>
    </ContentView.Resources>
    <Grid x:Name="Root">
        <ScrollView x:Name="Scroll" Padding="0,0,16,0">
            <VerticalStackLayout x:Name="Column" Spacing="24" HorizontalOptions="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <components:IconButton Glyph="{x:Static components:Icons.ArrowLeft}" GlyphSize="14" WidthRequest="32"
                                           IsOutlined="True" VerticalOptions="Start" AccessibleName="Back to Read Aloud"
                                           AutomationId="ProfileBack" Clicked="OnBackClicked" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label x:Name="TitleLabel" Style="{StaticResource PageTitle}" Text="Edit profile"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Style="{StaticResource PageSubtitle}"
                               Text="Its shortcut reads the selected text, or the clipboard, after the optional steps." />
                    </VerticalStackLayout>
                </Grid>

                <!-- Profile -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="Profile" FontFamily="InterSemiBold" FontSize="15" SemanticProperties.HeadingLevel="Level2" />

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Enabled" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="When off, the shortcut does nothing." />
                        </VerticalStackLayout>
                        <Switch x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource SettingToggle}" HorizontalOptions="End"
                                IsToggled="True" AutomationId="ProfileEnabled" SemanticProperties.Description="Enabled"
                                Toggled="OnEnabledToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Shortcut" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}"
                                   Text="Profiles may share a shortcut; they then read one after another. Dictation, processes, command sets and cancel can't use it." />
                        </VerticalStackLayout>
                        <components:ShortcutInput x:Name="ShortcutInput" Grid.Column="1" WidthRequest="360"
                                                  SettingName="read-aloud shortcut" DefaultShortcut="{x:Null}" Shortcut="{x:Null}"
                                                  AutomationId="ProfileShortcut" ShortcutChanged="OnShortcutChanged" />
                    </Grid>

                    <components:SharedShortcutNotice x:Name="ShortcutNotice" IsVisible="False" Glyph="{x:Static components:Icons.Volume2}"
                                                     LinkText="Change the order in Read Aloud" LinkClicked="OnBackClicked" />

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Name" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="Shown in the list and on the reader panel." />
                        </VerticalStackLayout>
                        <components:TextInput x:Name="NameInput" Grid.Column="1" WidthRequest="360" MaxLength="60"
                                              Placeholder="For example, Translate to German" AccessibleName="Profile name"
                                              AutomationId="ProfileName" PropertyChanged="OnInputPropertyChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Short description" FontFamily="InterMedium" FontSize="13" />
                                <Label Text="Optional" FontSize="12" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </HorizontalStackLayout>
                            <Label Style="{StaticResource SettingHelp}" Text="Only for you, to tell profiles apart. It is never sent to a model." />
                        </VerticalStackLayout>
                        <components:TextInput x:Name="DescriptionInput" Grid.Column="1" WidthRequest="360" MaxLength="120"
                                              Placeholder="What this profile is for" AccessibleName="Profile description"
                                              AutomationId="ProfileDescription" PropertyChanged="OnInputPropertyChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Copy result to clipboard" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}"
                                   Text="Puts the text that is read, after the steps, on the clipboard so you can paste it, for example the translation." />
                        </VerticalStackLayout>
                        <Switch x:Name="CopyToggle" Grid.Column="1" Style="{StaticResource SettingToggle}" HorizontalOptions="End"
                                AutomationId="ProfileCopyResult" SemanticProperties.Description="Copy result to clipboard"
                                Toggled="OnCopyToggled" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Save to History" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}"
                                   Text="Keeps each reading in the History, like a dictation: the spoken audio as a WAV file, the selected text and the result of the steps. It is deleted with the History's other recordings." />
                        </VerticalStackLayout>
                        <Switch x:Name="HistoryToggle" Grid.Column="1" Style="{StaticResource SettingToggle}" HorizontalOptions="End"
                                AutomationId="ProfileSaveToHistory" SemanticProperties.Description="Save to History"
                                Toggled="OnHistoryToggled" />
                    </Grid>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" HeightRequest="1" />

                <!-- Pre-processing -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="Pre-processing" FontFamily="InterSemiBold" FontSize="15" SemanticProperties.HeadingLevel="Level2" />
                    <Label Style="{StaticResource SettingHelp}" LineBreakMode="WordWrap"
                           Text="Optional steps that rewrite the text before it is read, in order, each on the result of the one before. Without steps the text is read as it is. If a step fails or takes too long, the selected text is read instead." />
                    <VerticalStackLayout x:Name="StepList" Spacing="12" />
                    <components:IconButton HeightRequest="32" HorizontalOptions="Start" Glyph="{x:Static components:Icons.Plus}" GlyphSize="14"
                                           Text="Add step" IsOutlined="True" AccessibleName="Add a pre-processing step"
                                           AutomationId="AddStep" Clicked="OnAddStepClicked" />
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" HeightRequest="1" />

                <!-- Voice -->
                <VerticalStackLayout Spacing="16">
                    <Label Text="Voice" FontFamily="InterSemiBold" FontSize="15" SemanticProperties.HeadingLevel="Level2" />

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Provider" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="Runs on this PC. No text leaves it." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="VoiceProviderSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.Cpu}" AccessibleName="Voice provider" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Model" FontFamily="InterMedium" FontSize="13" />
                            <Label x:Name="VoiceHelp" Style="{StaticResource SettingHelp}" Text="Downloaded voice models. Get more in TTS Models." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="VoiceModelSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.AudioLines}" AccessibleName="Voice model"
                                                AutomationId="ProfileVoiceModel" SelectedIndexChanged="OnVoiceModelChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Voice" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="The voices of that model." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="VoiceSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.Users}" AccessibleName="Voice"
                                                AutomationId="ProfileVoice" SelectedIndexChanged="OnVoiceChanged" />
                    </Grid>

                    <Grid x:Name="LanguageRow" ColumnDefinitions="*,360" ColumnSpacing="16" IsVisible="False">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Language" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}"
                                   Text="The language this voice speaks the text in. Shown for voices that speak several languages." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="LanguageSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.Languages}" AccessibleName="Language"
                                                AutomationId="ProfileLanguage" SelectedIndexChanged="OnLanguageChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Speed" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="How fast the voice reads. The reader panel can change it while reading." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="SpeedSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.Gauge}" AccessibleName="Speed"
                                                AutomationId="ProfileSpeed" SelectedIndexChanged="OnSpeedChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Volume" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="On top of the system volume." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="VolumeSelect" Grid.Column="1" WidthRequest="360"
                                                Glyph="{x:Static components:Icons.Volume2}" AccessibleName="Volume"
                                                AutomationId="ProfileVolume" SelectedIndexChanged="OnVolumeChanged" />
                    </Grid>

                    <HorizontalStackLayout Spacing="12">
                        <components:IconButton x:Name="PreviewButton" HeightRequest="36" Glyph="{x:Static components:Icons.Play}" GlyphSize="14"
                                               Text="Preview voice" IsOutlined="True" AccessibleName="Preview voice"
                                               AutomationId="ProfilePreview" Clicked="OnPreviewClicked" />
                        <Label x:Name="PreviewHint" Style="{StaticResource SettingHelp}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" HeightRequest="1" />

                <VerticalStackLayout Spacing="16">
                    <Label Text="Voice effect" FontFamily="InterSemiBold" FontSize="15" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="Effect" FontFamily="InterMedium" FontSize="13" />
                            <Label Style="{StaticResource SettingHelp}" Text="Change how the voice sounds. Works with any model." />
                        </VerticalStackLayout>
                        <components:SelectInput x:Name="EffectSelect" Grid.Column="1" WidthRequest="360"
                                                AccessibleName="Voice effect" AutomationId="ProfileVoiceEffect"
                                                SelectedIndexChanged="OnEffectChanged" />
                    </Grid>
                    <VerticalStackLayout x:Name="RobotControls" Spacing="16" IsVisible="False">

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Modulation" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Smooth metallic tone to a harsher robotic buzz." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RobotModulationSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Modulation percentage" AutomationId="ProfileRobotModulation"
                                        ValueChanged="OnRobotValueChanged" />
                                <Label x:Name="RobotModulationValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Robot pitch" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Frequency of the metallic tone, in Hz." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RobotPitchSlider" Style="{StaticResource RadioSlider}" Minimum="30" Maximum="180"
                                        SemanticProperties.Description="Robot pitch in Hertz" AutomationId="ProfileRobotPitch"
                                        ValueChanged="OnRobotValueChanged" />
                                <Label x:Name="RobotPitchValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Intensity" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Blend the robot effect with the original voice." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RobotIntensitySlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Intensity percentage" AutomationId="ProfileRobotIntensity"
                                        ValueChanged="OnRobotValueChanged" />
                                <Label x:Name="RobotIntensityValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <HorizontalStackLayout Spacing="12">
                            <components:IconButton x:Name="RobotPreviewButton" HeightRequest="36" Glyph="{x:Static components:Icons.Play}"
                                                   GlyphSize="14" Text="Preview robot voice" IsOutlined="True"
                                                   AccessibleName="Preview robot voice" AutomationId="ProfileRobotPreview" Clicked="OnPreviewClicked" />
                            <components:IconButton HeightRequest="36" Text="Reset effect" IsOutlined="True"
                                                   AccessibleName="Reset robot effect" AutomationId="ProfileRobotReset" Clicked="OnResetRobotClicked" />
                            <Label x:Name="RobotPreviewHint" Style="{StaticResource SettingHelp}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="SpacesuitControls" Spacing="16" IsVisible="False">

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Headset tone" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Higher values make the headset sound narrower and more muffled." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="SpacesuitToneSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Headset tone percentage" AutomationId="ProfileSpacesuitTone"
                                        ValueChanged="OnSpacesuitValueChanged" />
                                <Label x:Name="SpacesuitToneValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Static" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Add a little radio hiss while the voice speaks." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="SpacesuitStaticSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Static percentage" AutomationId="ProfileSpacesuitStatic"
                                        ValueChanged="OnSpacesuitValueChanged" />
                                <Label x:Name="SpacesuitStaticValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Transmission beep" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Play a brief beep at the start and end of each reading." />
                            </VerticalStackLayout>
                            <Switch x:Name="SpacesuitBeepToggle" Grid.Column="1" Style="{StaticResource SettingToggle}"
                                    OnColor="{AppThemeBinding Light={StaticResource SpeakingLight}, Dark={StaticResource SpeakingDark}}"
                                    HorizontalOptions="End" SemanticProperties.Description="Transmission beep"
                                    AutomationId="ProfileSpacesuitBeep" Toggled="OnSpacesuitBeepToggled" />
                        </Grid>
                        <HorizontalStackLayout Spacing="12">
                            <components:IconButton x:Name="SpacesuitPreviewButton" HeightRequest="36" Glyph="{x:Static components:Icons.Play}"
                                                   GlyphSize="14" Text="Preview headset voice" IsOutlined="True"
                                                   AccessibleName="Preview headset voice" AutomationId="ProfileSpacesuitPreview" Clicked="OnPreviewClicked" />
                            <components:IconButton HeightRequest="36" Text="Reset effect" IsOutlined="True"
                                                   AccessibleName="Reset headset effect" AutomationId="ProfileSpacesuitReset" Clicked="OnResetSpacesuitClicked" />
                            <Label x:Name="SpacesuitPreviewHint" Style="{StaticResource SettingHelp}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout x:Name="RadioControls" Spacing="16" IsVisible="False">

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Radio tone" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Higher values make the voice thinner and more muffled." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RadioToneSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Radio tone percentage" AutomationId="ProfileRadioTone"
                                        ValueChanged="OnRadioValueChanged" />
                                <Label x:Name="RadioToneValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Compression" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Even out quiet and loud speech for a steady radio sound." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RadioCompressionSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Compression percentage" AutomationId="ProfileRadioCompression"
                                        ValueChanged="OnRadioValueChanged" />
                                <Label x:Name="RadioCompressionValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Distortion" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Add a rough edge to the voice." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RadioDistortionSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Distortion percentage" AutomationId="ProfileRadioDistortion"
                                        ValueChanged="OnRadioValueChanged" />
                                <Label x:Name="RadioDistortionValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Static" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Mix a little radio hiss into the speech." />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="*,50" ColumnSpacing="12">
                                <Slider x:Name="RadioStaticSlider" Style="{StaticResource RadioSlider}" Minimum="0" Maximum="100"
                                        SemanticProperties.Description="Static percentage" AutomationId="ProfileRadioStatic"
                                        ValueChanged="OnRadioValueChanged" />
                                <Label x:Name="RadioStaticValue" Grid.Column="1" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="Transmission click" FontFamily="InterMedium" FontSize="13" />
                                <Label Style="{StaticResource SettingHelp}" Text="Play a short squelch at the start and end of each reading." />
                            </VerticalStackLayout>
                            <Switch x:Name="RadioClickToggle" Grid.Column="1" Style="{StaticResource SettingToggle}"
                                    OnColor="{AppThemeBinding Light={StaticResource SpeakingLight}, Dark={StaticResource SpeakingDark}}"
                                    HorizontalOptions="End" SemanticProperties.Description="Transmission click"
                                    AutomationId="ProfileRadioClick" Toggled="OnRadioClickToggled" />
                        </Grid>
                        <HorizontalStackLayout Spacing="12">
                            <components:IconButton x:Name="RadioPreviewButton" HeightRequest="36" Glyph="{x:Static components:Icons.Play}"
                                                   GlyphSize="14" Text="Preview radio voice" IsOutlined="True"
                                                   AccessibleName="Preview radio voice" AutomationId="ProfileRadioPreview" Clicked="OnPreviewClicked" />
                            <components:IconButton HeightRequest="36" Text="Reset effect" IsOutlined="True"
                                                   AccessibleName="Reset radio effect" AutomationId="ProfileRadioReset" Clicked="OnResetRadioClicked" />
                            <Label x:Name="RadioPreviewHint" Style="{StaticResource SettingHelp}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" HeightRequest="1" />

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <components:IconButton x:Name="DeleteButton" HeightRequest="36" Glyph="{x:Static components:Icons.Trash2}"
                                           GlyphSize="14" Text="Delete profile" IsOutlined="True" IsDestructive="True"
                                           AccessibleName="Delete profile" AutomationId="DeleteProfile" Clicked="OnDeleteClicked" />
                    <components:IconButton x:Name="RevertButton" Grid.Column="2" HeightRequest="36" WidthRequest="88" Text="Revert"
                                           IsOutlined="True" AccessibleName="Revert changes" AutomationId="RevertProfile"
                                           Clicked="OnRevertClicked" />
                    <components:IconButton x:Name="SaveButton" Grid.Column="3" HeightRequest="36" WidthRequest="88" Text="Save"
                                           IsPrimary="True" AccessibleName="Save profile" AutomationId="SaveProfile"
                                           Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Model menu layer for the steps: a nearly transparent backdrop closes the menu when anything else is clicked. -->
        <Grid x:Name="MenuLayer" IsVisible="False">
            <Grid BackgroundColor="#01000000">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuBackdropTapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <components:OptionMenu x:Name="ModelMenu" HorizontalOptions="Start" VerticalOptions="Start" OptionChosen="OnModelChosen" />
        </Grid>
    </Grid>
</ContentView>
