<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Rambl.Components"
             x:Class="Rambl.Views.ReadAloud"
             Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged">
    <Grid>
        <Grid x:Name="Column" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="18" HorizontalOptions="Center">
            <!-- Title and the New profile button. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource PageTitle}" Text="Read Aloud" SemanticProperties.HeadingLevel="Level1" />
                    <Label Style="{StaticResource PageSubtitle}"
                           Text="Press a profile's shortcut to hear the selected text, or the clipboard. Steps can rewrite it first." />
                </VerticalStackLayout>
                <components:IconButton x:Name="NewButton" Grid.Column="1" Glyph="{x:Static components:Icons.Plus}"
                                       GlyphSize="14" Text="New profile" IsPrimary="True" VerticalOptions="Start"
                                       AccessibleName="New profile" AutomationId="NewProfile" Clicked="OnNewClicked" />
            </Grid>

            <components:SearchField x:Name="Search" Grid.Row="1" Placeholder="Search profiles…"
                                    AccessibleName="Search profiles" AutomationId="ProfileSearch" />

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="32">
                <components:FilterToggle x:Name="AttentionToggle" Glyph="{x:Static components:Icons.TriangleAlert}"
                                         Text="Needs attention" AutomationId="ProfileNeedsAttention"
                                         CheckedChanged="OnAttentionChanged" />
                <Label x:Name="CountLabel" Grid.Column="1" Style="{StaticResource SettingHelp}" HorizontalOptions="End"
                       VerticalOptions="Center" AutomationId="ProfileCount" />
            </Grid>

            <Grid x:Name="HintRow" Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                <Label Style="{StaticResource Icon}" FontSize="12" VerticalOptions="Start" Margin="0,2,0,0"
                       Text="{x:Static components:Icons.Info}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Label Grid.Column="1" Style="{StaticResource StatusText}" LineBreakMode="WordWrap" VerticalOptions="Start"
                       Text="Profiles that share a shortcut read one after another, top to bottom, each from the selected text. Dictation, processes and command sets can't use a profile's shortcut. Press the shortcut again to stop." />
            </Grid>

            <!-- How the reader panel behaves, for every profile. -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="Close the panel when reading finishes" FontFamily="InterMedium" FontSize="13" />
                    <Label Style="{StaticResource SettingHelp}"
                           Text="Otherwise it stays open so you can read the text again. The reader window always stays open." />
                </VerticalStackLayout>
                <Switch x:Name="CloseWhenFinishedToggle" Grid.Column="1" Style="{StaticResource SettingToggle}"
                        AutomationId="CloseReaderWhenFinished" SemanticProperties.Description="Close the panel when reading finishes"
                        Toggled="OnCloseWhenFinishedToggled" />
            </Grid>

            <Grid Grid.Row="5">
                <ScrollView>
                    <VerticalStackLayout x:Name="List" Spacing="24" />
                </ScrollView>
                <Label x:Name="MessageLabel" IsVisible="False" Style="{StaticResource PageSubtitle}" VerticalOptions="Start"
                       AutomationId="ProfileMessage" />
            </Grid>
        </Grid>

        <!-- The edit layer takes the place of the list; Read Aloud stays selected in the sidebar. -->
        <ContentView x:Name="EditorHost" IsVisible="False" />
    </Grid>
</ContentView>
