<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Rambl.Components"
             x:Class="Rambl.Views.TtsModels"
             SizeChanged="OnSizeChanged">

    <Grid x:Name="Column" RowDefinitions="Auto,Auto,*" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="4">
            <Label Style="{StaticResource PageTitle}"
                   Text="TTS Models"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Style="{StaticResource PageSubtitle}"
                   Text="Find and manage the voices that read text aloud. Everything runs on this PC." />
        </VerticalStackLayout>

        <components:TabStrip x:Name="ModelTabs" Grid.Row="1" Margin="0,24,0,18" Labels="Local,Browse"
                             SelectedIndexChanged="OnTabChanged" />

        <ContentView x:Name="TabContent" Grid.Row="2" />
    </Grid>

</ContentView>
