<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <!-- Design tokens from docs/design.pen (Light / Dark pairs).
         MAUI hex colors with alpha are #AARRGGBB (the .pen file uses #RRGGBBAA). -->
    <Color x:Key="WindowBgLight">#F4F4F2</Color>
    <Color x:Key="WindowBgDark">#141416</Color>
    <Color x:Key="SidebarBgLight">#ECECE9</Color>
    <Color x:Key="SidebarBgDark">#1A1A1D</Color>
    <Color x:Key="ContentBgLight">#FFFFFF</Color>
    <Color x:Key="ContentBgDark">#1F1F23</Color>
    <Color x:Key="BorderLight">#DEDEDA</Color>
    <Color x:Key="BorderDark">#2C2C32</Color>
    <Color x:Key="PlaceholderLight">#F2F2EF</Color>
    <Color x:Key="PlaceholderDark">#26262B</Color>
    <Color x:Key="PlaceholderStrokeLight">#E2E2DE</Color>
    <Color x:Key="PlaceholderStrokeDark">#313137</Color>
    <Color x:Key="TextPrimaryLight">#18181B</Color>
    <Color x:Key="TextPrimaryDark">#EDEDEF</Color>
    <Color x:Key="TextSecondaryLight">#5B5B63</Color>
    <Color x:Key="TextSecondaryDark">#A6A6AF</Color>
    <Color x:Key="TextMutedLight">#8A8A92</Color>
    <Color x:Key="TextMutedDark">#6E6E78</Color>
    <Color x:Key="AccentLight">#0F766E</Color>
    <Color x:Key="AccentDark">#2DD4BF</Color>
    <Color x:Key="AccentSoftLight">#140F766E</Color>
    <Color x:Key="AccentSoftDark">#1A2DD4BF</Color>
    <Color x:Key="SuccessLight">#16A34A</Color>
    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="WarningLight">#B45309</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="WarningSoftLight">#14B45309</Color>
    <Color x:Key="WarningSoftDark">#1AFBBF24</Color>
    <Color x:Key="ProcessingLight">#7C3AED</Color>
    <Color x:Key="ProcessingDark">#A78BFA</Color>
    <Color x:Key="ProcessingSoftLight">#147C3AED</Color>
    <Color x:Key="ProcessingSoftDark">#1FA78BFA</Color>
    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="DangerSoftLight">#14DC2626</Color>
    <Color x:Key="DangerSoftDark">#1AF87171</Color>
    <Color x:Key="DangerBorderLight">#55DC2626</Color>
    <Color x:Key="DangerBorderDark">#55F87171</Color>
    <Color x:Key="SwitchTrackOff">#C8C8C3</Color>
    <Color x:Key="OverlayShadowLight">#18000000</Color>
    <Color x:Key="OverlayShadowDark">#55000000</Color>

    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryDark">#2DD4BF</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="OverlayShadowLightBrush" Color="{StaticResource OverlayShadowLight}"/>
    <SolidColorBrush x:Key="OverlayShadowDarkBrush" Color="{StaticResource OverlayShadowDark}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
